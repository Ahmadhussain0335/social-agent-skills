{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "YouTube shot list",
  "type": "object",
  "required": ["segments"],
  "properties": {
    "resolution": { "type": "string", "pattern": "^[0-9]+x[0-9]+$", "default": "1920x1080", "description": "Use 1080x1920 for Shorts." },
    "fps": { "type": "number", "minimum": 1, "maximum": 120, "default": 30 },
    "voiceover": { "type": "string", "description": "Narration audio, relative to the project folder." },
    "music": {
      "type": "object",
      "required": ["file"],
      "properties": {
        "file": { "type": "string" },
        "volume": { "type": "number", "minimum": 0, "maximum": 1, "default": 0.15 }
      }
    },
    "subtitles": { "type": "string", "description": "SRT file, muxed as a soft subtitle track." },
    "segments": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["file"],
        "properties": {
          "file": { "type": "string", "description": "Image (png, jpg, webp, bmp) or video (mp4, mov, mkv, webm, m4v, avi)." },
          "duration": { "type": "number", "exclusiveMinimum": 0, "description": "Seconds. Required for images." },
          "note": { "type": "string", "description": "What this segment shows and which script section it covers." }
        }
      }
    },
    "output": { "type": "string", "default": "output/video.mp4" }
  }
}
