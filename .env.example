# Copy values into your shell profile or a secret manager. Never commit real values.
# Credential files must live outside any git repository.

# YouTube uploads: OAuth client JSON of type "Desktop app" from your own Google Cloud project
YT_CLIENT_SECRET_PATH=/home/you/.config/social-skills/youtube/client_secret.json

# Optional: where the OAuth token is stored (default: <config dir>/youtube/token.json)
# YT_TOKEN_PATH=/home/you/.config/social-skills/youtube/token.json

# YouTube research: API key restricted to YouTube Data API v3
YT_API_KEY=

# Optional: ffmpeg binary for youtube-assemble
# FFMPEG_PATH=/usr/local/bin/ffmpeg

# Optional: override the config directory (default ~/.config/social-skills, %APPDATA%\social-skills on Windows)
# SOCIAL_SKILLS_CONFIG_DIR=

# Meta (Facebook Pages, Instagram) and Threads
# META_APP_ID= / META_APP_SECRET= / META_REDIRECT_URI=https://ahmadhussain.dev/social-skills-oauth/
# THREADS_APP_ID= / THREADS_APP_SECRET= / THREADS_REDIRECT_URI=
# WhatsApp Cloud API
# WA_ACCESS_TOKEN= / WA_PHONE_NUMBER_ID= / WA_WABA_ID= / WA_APP_SECRET= / WA_VERIFY_TOKEN=
# X (Native App client id, no secret)
# X_CLIENT_ID=
# LinkedIn
# LINKEDIN_CLIENT_ID= / LINKEDIN_CLIENT_SECRET= / LINKEDIN_REDIRECT_URI=
# Pinterest
# PINTEREST_APP_ID= / PINTEREST_APP_SECRET= / PINTEREST_REDIRECT_URI=
# TikTok
# TIKTOK_CLIENT_KEY= / TIKTOK_CLIENT_SECRET=
# Telegram
# TELEGRAM_BOT_TOKEN= / TELEGRAM_CHAT_ID=@yourchannel
# Discord (the webhook URL is a secret)
# DISCORD_WEBHOOK_URL=
# Bluesky (app password, never the account password)
# BLUESKY_HANDLE= / BLUESKY_APP_PASSWORD=
# Mastodon
# MASTODON_INSTANCE=https://mastodon.social / MASTODON_ACCESS_TOKEN=
# Google Business Profile (defaults to YT_CLIENT_SECRET_PATH)
# GBP_CLIENT_SECRET_PATH=
